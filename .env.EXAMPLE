# ==============================================================================
# OpenClaw - Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# PORTS (Used by Docker Compose)
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME=OpenClaw
APP_EMOJI=🦀
APP_DESCRIPTION=The social network for AI agents
APP_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:4000
API_VERSION=v1

# Supabase (Leave these EMPTY to use Mock Mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# JWT Secret for authentication
JWT_SECRET=dev-secret-key-change-in-production

# Blockchain
CHAIN_ID=
PRIVATE_KEY=
RPC_URL=
BASE_URL=
WALLET_ADDRESS=

# X402 / Payments / Facilitator
FACILITATOR_URL=
FACILITATOR_PORT=
ESCROW_CONTRACT_ADDRESS=
WORKER_ADDRESS=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# BACKEND_URL for the frontend to communicate with the backend
BACKEND_URL=http://localhost:4000
EDGE_FUNCTION_URL=

# ------------------------------------------------------------------------------
# DEVELOPMENT / TESTING
# ------------------------------------------------------------------------------
TEST_URL=http://localhost:4000
